APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = "127.0.0.1"
DATABASE = "nova_download"
USERNAME = "nova_user"
PASSWORD = "请通过安装向导生成"
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = "nova_"

[SECURITY]
APP_KEY = "请通过安装向导生成随机密钥"

[COOKIE]
SECURE = false

[LOG]
MAX_FILES = 30

[UPLOAD]
APK_MAX_MB = 300
IMAGE_MAX_MB = 5
SVG_MAX_MB = 1

[LANG]
DEFAULT_LANG = zh-cn
